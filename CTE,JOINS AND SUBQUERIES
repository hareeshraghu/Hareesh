                                                        CTE,JOINS AND SUBQUERIES

1.	WITH PatientData AS ( SELECT * FROM Patients ) SELECT * FROM PatientData;
2.	WITH AverageAge AS ( SELECT AVG(age) AS avg_age FROM Patients ) SELECT * FROM Patients WHERE age > ( SELECT avg_age FROM AverageAge );
3.	WITH DoctorAppointments AS (  SELECT doctor_id,COUNT(*) AS appointment_count  FROM Appointments GROUP BY doctor_id)
SELECT d.doctor_id,  d.doctor_name,   da.appointment_count FROM Doctors d JOIN DoctorAppointments da ON d.doctor_id = da.doctor_id WHERE da.appointment_count > 1;
4.	WITH DepartmentAppointments AS ( SELECT d.department_id, d.department_name, COUNT(a.appointment_id) AS appointment_count FROM Departments d JOIN Doctors doc ON d.department_id = doc.department_id JOIN Appointments a ON doc.doctor_id = a.doctor_id GROUP BY d.department_id, d.department_name ) SELECT * FROM DepartmentAppointments;
5.	WITH TreatmentCosts AS ( SELECT treatment_id, treatment_name, cost FROM Treatments ) SELECT * FROM TreatmentCosts ORDER BY cost DESC LIMIT 3;
6.	SELECT p.patient_id, p.patient_name, b.total_amount FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id JOIN Billing b ON a.appointment_id = b.appointment_id WHERE b.total_amount > ( SELECT AVG(total_amount) FROM Billing );
7.	SELECT d.department_name, SUM(b.total_amount) AS total_revenue FROM Departments d JOIN Doctors doc ON d.department_id = doc.department_id JOIN Appointments a ON doc.doctor_id = a.doctor_id JOIN Billing b ON a.appointment_id = b.appointment_id GROUP BY d.department_id, d.department_name;
8.	SELECT p.patient_id, p.patient_name, COUNT(DISTINCT doc.department_id) AS department_count FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id JOIN Doctors doc ON a.doctor_id = doc.doctor_id GROUP BY p.patient_id, p.patient_name HAVING COUNT(DISTINCT doc.department_id) > 1;
9.	SELECT doc.doctor_name, COUNT(t.treatment_id) AS treatment_count FROM Doctors doc JOIN Appointments a ON doc.doctor_id = a.doctor_id JOIN Treatments t ON a.appointment_id = t.appointment_id GROUP BY doc.doctor_id, doc.doctor_name;
10.	SELECT p.patient_id, p.patient_name, b.total_amount, b.payment_status FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id JOIN Billing b ON a.appointment_id = b.appointment_id WHERE b.payment_status = 'Pending';
11.	SELECT p.patient_name, doc.doctor_name, d.department_name FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id JOIN Doctors doc ON a.doctor_id = doc.doctor_id JOIN Departments d ON doc.department_id = d.department_id;
12.	SELECT p.patient_name, t.treatment_name, t.cost FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id JOIN Treatments t ON a.appointment_id = t.appointment_id;
13.	SELECT p.patient_name, m.medicine_name, m.price, pr.quantity FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id JOIN Prescriptions pr ON a.appointment_id = pr.appointment_id JOIN Medicines m ON pr.medicine_id = m.medicine_id;
14.	SELECT d.department_name, SUM(b.total_amount) AS total_billing FROM Departments d JOIN Doctors doc ON d.department_id = doc.department_id JOIN Appointments a ON doc.doctor_id = a.doctor_id JOIN Billing b ON a.appointment_id = b.appointment_id GROUP BY d.department_id, d.department_name;
15.	SELECT p.patient_name, b.total_amount FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id JOIN Billing b ON a.appointment_id = b.appointment_id WHERE b.total_amount = ( SELECT MAX(total_amount) FROM Billing );
16.	SELECT doc.doctor_name, SUM(b.total_amount) AS total_revenue FROM Doctors doc JOIN Appointments a ON doc.doctor_id = a.doctor_id JOIN Billing b ON a.appointment_id = b.appointment_id GROUP BY doc.doctor_id, doc.doctor_name;
17.	SELECT a.appointment_id, a.appointment_date, p.patient_name, b.total_amount, b.payment_status FROM Appointments a JOIN Patients p ON a.patient_id = p.patient_id LEFT JOIN Billing b ON a.appointment_id = b.appointment_id;
18.	SELECT p.patient_id, p.patient_name FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id LEFT JOIN Prescriptions pr ON a.appointment_id = pr.appointment_id WHERE pr.prescription_id IS NULL;
19.	SELECT d.doctor_id, d.doctor_name FROM Doctors d LEFT JOIN Appointments a ON d.doctor_id = a.doctor_id WHERE a.appointment_id IS NULL;
20.	SELECT d.department_name, COUNT(DISTINCT a.patient_id) AS patient_count FROM Departments d JOIN Doctors doc ON d.department_id = doc.department_id JOIN Appointments a ON doc.doctor_id = a.doctor_id GROUP BY d.department_id, d.department_name;
21.	SELECT p.patient_name, b.total_amount FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id JOIN Billing b ON a.appointment_id = b.appointment_id WHERE b.total_amount > ( SELECT AVG(total_amount) FROM Billing );
22.	WITH DepartmentRevenue AS ( SELECT d.department_id, d.department_name, SUM(b.total_amount) AS total_revenue FROM Departments d JOIN Doctors doc ON d.department_id = doc.department_id JOIN Appointments a ON doc.doctor_id = a.doctor_id JOIN Billing b ON a.appointment_id = b.appointment_id GROUP BY d.department_id, d.department_name ) SELECT doc.doctor_name, dr.department_name, dr.total_revenue FROM Doctors doc JOIN DepartmentRevenue dr ON doc.department_id = dr.department_id WHERE dr.total_revenue = ( SELECT MAX(total_revenue) FROM DepartmentRevenue );
23.	SELECT p.patient_name, m.medicine_name, m.price FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id JOIN Prescriptions pr ON a.appointment_id = pr.appointment_id JOIN Medicines m ON pr.medicine_id = m.medicine_id WHERE m.price = ( SELECT MAX(price) FROM Medicines );
24.	WITH DepartmentRevenue AS ( SELECT d.department_id, d.department_name, SUM(b.total_amount) AS total_revenue FROM Departments d JOIN Doctors doc ON d.department_id = doc.department_id JOIN Appointments a ON doc.doctor_id = a.doctor_id JOIN Billing b ON a.appointment_id = b.appointment_id GROUP BY d.department_id, d.department_name ) SELECT * FROM DepartmentRevenue WHERE total_revenue > ( SELECT AVG(total_revenue) FROM DepartmentRevenue );
25.	WITH DoctorAppointments AS ( SELECT doctor_id, COUNT(*) AS appointment_count FROM Appointments GROUP BY doctor_id ) SELECT d.doctor_name, da.appointment_count FROM Doctors d JOIN DoctorAppointments da ON d.doctor_id = da.doctor_id WHERE da.appointment_count = ( SELECT MAX(appointment_count) FROM DoctorAppointments );
26.	SELECT p.patient_name, t.treatment_name, t.cost FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id JOIN Treatments t ON a.appointment_id = t.appointment_id WHERE t.cost > ( SELECT AVG(cost) FROM Treatments );
27.	SELECT m.medicine_name, pr.quantity FROM Medicines m JOIN Prescriptions pr ON m.medicine_id = pr.medicine_id WHERE pr.quantity > ( SELECT AVG(quantity) FROM Prescriptions );
28.	SELECT p.patient_id, p.patient_name, SUM(b.total_amount) AS total_expenditure FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id JOIN Billing b ON a.appointment_id = b.appointment_id GROUP BY p.patient_id, p.patient_name;
29.	SELECT d.department_id, d.department_name FROM Departments d WHERE NOT EXISTS ( SELECT 1 FROM Doctors doc JOIN Appointments a ON doc.doctor_id = a.doctor_id JOIN Billing b ON a.appointment_id = b.appointment_id WHERE doc.department_id = d.department_id AND b.payment_status = 'Pending' );
30.	WITH DepartmentRevenue AS ( SELECT d.department_id, d.department_name, SUM(b.total_amount) AS department_revenue FROM Departments d JOIN Doctors doc ON d.department_id = doc.department_id JOIN Appointments a ON doc.doctor_id = a.doctor_id JOIN Billing b ON a.appointment_id = b.appointment_id GROUP BY d.department_id, d.department_name ), PatientBills AS ( SELECT p.patient_id, p.patient_name, SUM(b.total_amount) AS total_bill FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id JOIN Billing b ON a.appointment_id = b.appointment_id GROUP BY p.patient_id, p.patient_name ) SELECT p.patient_name, doc.doctor_name, d.department_name, t.treatment_name, t.cost, m.medicine_name, pr.quantity, b.total_amount, b.payment_status, dr.department_revenue, pb.total_bill FROM Patients p JOIN Appointments a ON p.patient_id = a.patient_id JOIN Doctors doc ON a.doctor_id = doc.doctor_id JOIN Departments d ON doc.department_id = d.department_id LEFT JOIN Treatments t ON a.appointment_id = t.appointment_id LEFT JOIN Prescriptions pr ON a.appointment_id = pr.appointment_id LEFT JOIN Medicines m ON pr.medicine_id = m.medicine_id LEFT JOIN Billing b ON a.appointment_id = b.appointment_id LEFT JOIN DepartmentRevenue dr ON d.department_id = dr.department_id LEFT JOIN PatientBills pb ON p.patient_id = pb.patient_id;
