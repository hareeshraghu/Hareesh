1. Display all customers with their orders
SELECT  c.CustomerID, c.CustomerName,  o.OrderID,  o.OrderDate FROM Customers c INNER JOIN Orders o ON c.CustomerID o.CustomerID;
2. Display order details with customer names
SELECT o.OrderID, c.CustomerName, o.OrderDate FROM Orders o INNER JOIN Customers c ON o.CustomerID = c.CustomerID;
3. Show every product with its category
SELECT  p.ProductID,  p.ProductName, c.CategoryName FROM Products p INNER JOIN Categories c ON p.CategoryID = c.CategoryID;
4. Display products with supplier names
SELECT  p.ProductID, p.ProductName, s.SupplierName FROM Products p INNER JOIN Suppliers s ON p.SupplierID = s.SupplierID;
5. Show orders handled by each employee
SELECT  o.OrderID, e.EmployeeName, o.OrderDate FROM Orders o INNER JOIN Employees e ON o.EmployeeID = e.EmployeeID;
6. Display orders with shipper names
SELECT o.OrderID,  s.ShipperName, o.OrderDate FROM Orders o INNER JOIN Shippers s ON o.ShipperID = s.ShipperID;
7. Show customers who placed at least one order
SELECT DISTINCT c.CustomerID,  c.CustomerName FROM Customers c INNER JOIN Orders o ON c.CustomerID = o.CustomerID;
8. Display products purchased in each order
SELECT oi.OrderID, p.ProductName  oi.Quantity FROM Order_Items oi INNER JOIN Products p ON oi.ProductID = p.ProductID;
9. Display product name and quantity ordered
SELECT  p.ProductName, oi.Quantity FROM Products p INNER JOIN Order_Items oi ON p.ProductID = oi.ProductID;
10. Display employee names and customer names
SELECT  e.EmployeeName, c.CustomerName,   o.OrderID FROM Orders o INNER JOIN Employees e ON o.EmployeeID = e.EmployeeID INNER JOIN Customers c ON o.CustomerID = c.CustomerID;
11. Display customer, order, product, quantity and price
SELECT c.CustomerName, o.OrderID,  p.ProductName,  oi.Quantity, p.Price FROM Customers c INNER JOIN Orders o ON c.CustomerID = o.CustomerID INNER JOIN Order_Items oi ON o.OrderID = oi.OrderID INNER JOIN Products p ON oi.ProductID = p.ProductID;
12. Display supplier name with products sold
SELECT  s.SupplierName,  p.ProductName,  p.Price FROM Suppliers s INNER JOIN Products p ON s.SupplierID = p.SupplierID;
13. Display category-wise product count
SELECT c.CategoryName,COUNT(p.ProductID) AS ProductCount FROM Categories c LEFT JOIN Products p ON c.CategoryID = p.CategoryID
GROUP BY c.CategoryID c.CategoryName;
14. Find total orders for each customer
SELECT c.CustomerID, c.CustomerName, COUNT(o.OrderID) AS TotalOrders FROM Customers c LEFT JOIN Orders o ON c.CustomerID = o.CustomerID GROUP BY c.CustomerID,  c.CustomerName;
15. Find total sales by employee
SELECT e.EmployeeName, SUM(oi.Quantity * p.Price) AS TotalSales FROM Employees e INNER JOIN Orders o ON e.EmployeeID = o.EmployeeID INNER JOIN Order_Items oi ON o.OrderID = oi.OrderID INNER JOIN Products p ON oi.ProductID = p.ProductID GROUP BY e.EmployeeID, e.EmployeeName;
16. Find total revenue by category
SELECT c.CategoryName, SUM(oi.Quantity * p.Price) AS TotalRevenue FROM Categories c INNER JOIN Products p ON c.CategoryID = p.CategoryID INNER JOIN Order_Items oi ON p.ProductID = oi.ProductID GROUP BY c.CategoryID, c.CategoryName;
17. Display the most expensive product in every category
SELECT c.CategoryName, p.ProductName, p.Price FROM Products p INNER JOIN Categories c ON p.CategoryID = c.CategoryID WHERE p.Price = ( SELECT MAX(p2.Price) FROM Products p2 WHERE p2.CategoryID = p.CategoryID );
18. Find products never ordered
SELECT p.ProductID, p.ProductName FROM Products p LEFT JOIN Order_Items oi ON p.ProductID = oi.ProductID WHERE oi.ProductID IS NULL;
19. Find customers who never placed orders
SELECT c.CustomerID,  c.CustomerName FROM Customers c LEFT JOIN Orders o ON c.CustomerID = o.CustomerID WHERE o.OrderID IS NULL;
20. Display suppliers without products
SELECT s.SupplierID,  s.SupplierName FROM Suppliers s LEFT JOIN Products p ON s.SupplierID = p.SupplierID WHERE p.ProductID IS NULL;
21. Find top five customers by spending
SELECT c.CustomerName, SUM(oi.Quantity * p.Price) AS TotalSpending FROM Customers c INNER JOIN Orders o ON c.CustomerID = o.CustomerID
INNER JOIN Order_Items oi ON o.OrderID = oi.OrderID INNER JOIN Products p ON oi.ProductID = p.ProductID
GROUP BY c.CustomerID, c.CustomerName
ORDER BY TotalSpending DESC LIMIT 5;
22. Display monthly sales by employee
SELECT e.EmployeeName, YEAR(o.OrderDate) AS SalesYear, MONTH(o.OrderDate) AS SalesMonth, SUM(oi.Quantity * p.Price) AS MonthlySales FROM Employees e INNER JOIN Orders o ON e.EmployeeID = o.EmployeeID INNER JOIN Order_Items oi ON o.OrderID = oi.OrderID INNER JOIN Products p ON oi.ProductID = p.ProductID
GROUP BY e.EmployeeID, e.EmployeeName, YEAR(o.OrderDate)  MONTH(o.OrderDate)
ORDER BY SalesYear, SalesMonth;
23. Find the best-selling product
SELECT p.ProductName, SUM(oi.Quantity) AS TotalQuantitySold FROM Products p INNER JOIN Order_Items oi ON p.ProductID = oi.ProductID GROUP BY p.ProductID, p.ProductName ORDER BY TotalQuantitySold DESC LIMIT 1;
24. Display supplier-wise revenue
SELECT s.SupplierName, SUM(oi.Quantity * p.Price) AS TotalRevenue FROM Suppliers s INNER JOIN Products p ON s.SupplierID = p.SupplierID INNER JOIN Order_Items oi ON p.ProductID = oi.ProductID GROUP BY s.SupplierID, s.SupplierName;
25. Find average order value per customer
SELECT c.CustomerName, AVG(OrderTotal.TotalAmount) AS AverageOrderValue FROM Customers c INNER JOIN ( SELECT o.OrderID, o.CustomerID, SUM(oi.Quantity * p.Price) AS TotalAmount FROM Orders o INNER JOIN Order_Items oi ON o.OrderID = oi.OrderID INNER JOIN Products p ON oi.ProductID = p.ProductID GROUP BY o.OrderID, o.CustomerID ) AS OrderTotal ON c.CustomerID = OrderTotal.CustomerID GROUP BY c.CustomerID, c.CustomerName;
26. Display orders with more than three products
SELECT o.OrderID, SUM(oi.Quantity) AS TotalProducts FROM Orders o INNER JOIN Order_Items oi ON o.OrderID = oi.OrderID GROUP BY o.OrderID HAVING SUM(oi.Quantity) > 3;
27. Find customers ordering from multiple categories
SELECT c.CustomerName, COUNT(DISTINCT p.CategoryID) AS CategoryCount FROM Customers c INNER JOIN Orders o ON c.CustomerID = o.CustomerID INNER JOIN Order_Items oi ON o.OrderID = oi.OrderID INNER JOIN Products p ON oi.ProductID = p.ProductID GROUP BY c.CustomerID, c.CustomerName HAVING COUNT(DISTINCT p.CategoryID) > 1;
28. Display categories with no sales
SELECT c.CategoryID, c.CategoryName FROM Categories c LEFT JOIN Products p ON c.CategoryID = p.CategoryID LEFT JOIN Order_Items oi ON p.ProductID = oi.ProductID WHERE oi.OrderItemID IS NULL;
29. Display the highest-value order
SELECT o.OrderID, c.CustomerName, SUM(oi.Quantity * p.Price) AS OrderValue FROM Orders o INNER JOIN Customers c ON o.CustomerID = c.CustomerID INNER JOIN Order_Items oi ON o.OrderID = oi.OrderID INNER JOIN Products p ON oi.ProductID = p.ProductID GROUP BY o.OrderID, c.CustomerName ORDER BY OrderValue DESC LIMIT 1;
