1. Find the customer with the highest account balance
SELECT customer_name
FROM Customers
WHERE customer_id = (
    SELECT customer_id
    FROM Accounts
    WHERE balance = (
        SELECT MAX(balance)
        FROM Accounts
    )
);

2. Find the account with the minimum balance
SELECT *
FROM Accounts
WHERE balance = (
    SELECT MIN(balance)
    FROM Accounts
);

3. Find customers whose balance is greater than the average balance
SELECT customer_name
FROM Customers
WHERE customer_id IN (
    SELECT customer_id
    FROM Accounts
    WHERE balance > (
        SELECT AVG(balance)
        FROM Accounts
    )
);

4. Find customers whose balance is less than the maximum balance
SELECT customer_name
FROM Customers
WHERE customer_id IN (
    SELECT customer_id
    FROM Accounts
    WHERE balance < (
        SELECT MAX(balance)
        FROM Accounts
    )
);

5. Display account(s) having the second-highest balance
SELECT *
FROM Accounts
WHERE balance = (
    SELECT MAX(balance)
    FROM Accounts
    WHERE balance < (
        SELECT MAX(balance)
        FROM Accounts
    )
);

-- 6. Find customers who have taken a loan.
SELECT *
FROM Customers
WHERE customer_id IN (
    SELECT customer_id FROM Loans
);

-- 7. Find customers who have not taken any loan.
SELECT *
FROM Customers
WHERE customer_id NOT IN (
    SELECT customer_id FROM Loans
);

-- 8. Find accounts belonging to Chennai branches.
SELECT *
FROM Accounts
WHERE branch_id IN (
    SELECT branch_id
    FROM Branches
    WHERE city='Chennai'
);

-- 9. Find customers whose accounts are in Chennai branches.
SELECT *
FROM Customers
WHERE customer_id IN (
    SELECT customer_id
    FROM Accounts
    WHERE branch_id IN (
        SELECT branch_id
        FROM Branches
        WHERE city='Chennai'
    )
    );

-- 10. Customers with transactions greater than 20000.
SELECT *
FROM Customers
WHERE customer_id IN (
    SELECT customer_id
    FROM Accounts
    WHERE account_no IN (
        SELECT account_no
        FROM Transactions
        WHERE amount>20000
    )
);

-- 11. Customers whose balance is above average of their branch.
SELECT c.*
FROM Customers c
JOIN Accounts a ON c.customer_id=a.customer_id
WHERE a.balance>(
    SELECT AVG(balance)
    FROM Accounts
    WHERE branch_id=a.branch_id
);

-- 12. Branches with more accounts than average branch.
SELECT *
FROM Branches
WHERE branch_id IN (
SELECT branch_id
FROM Accounts
GROUP BY branch_id
HAVING COUNT(*)>(
SELECT AVG(cnt)
FROM(
SELECT COUNT(*) cnt
FROM Accounts
GROUP BY branch_id
)x
));

-- 13. Customers whose total transaction amount exceeds current balance.
SELECT c.*
FROM Customers c
JOIN Accounts a ON c.customer_id=a.customer_id
WHERE (
SELECT SUM(amount)
FROM Transactions t
WHERE t.account_no=a.account_no
)>a.balance;
-- 14. Accounts with more transactions than average account.
SELECT account_no
FROM Transactions
GROUP BY account_no
HAVING COUNT(*)>(
SELECT AVG(cnt)
FROM(
SELECT COUNT(*) cnt
FROM Transactions
GROUP BY account_no
)x
);
-- 15. Loan payments above average payment for same loan.
SELECT *
FROM Loan_Payments lp
WHERE payment_amount>(
SELECT AVG(payment_amount)
FROM Loan_Payments
WHERE loan_id=lp.loan_id
);

-- 16. Customers who have transactions (EXISTS).
SELECT *
FROM Customers c
WHERE EXISTS(
SELECT *
FROM Accounts a
JOIN Transactions t
ON a.account_no=t.account_no
WHERE a.customer_id=c.customer_id
);
-- 17. Customers with no transactions (NOT EXISTS).
SELECT *
FROM Customers c
WHERE NOT EXISTS(
SELECT *
FROM Accounts a
JOIN Transactions t
ON a.account_no=t.account_no
WHERE a.customer_id=c.customer_id
);

-- 18. Branches with at least one account.
SELECT *
FROM Branches b
WHERE EXISTS(
SELECT *
FROM Accounts a
WHERE a.branch_id=b.branch_id
);

-- 19. Branches with no accounts.
SELECT *
FROM Branches b
WHERE NOT EXISTS(
SELECT *
FROM Accounts a
WHERE a.branch_id=b.branch_id
);

-- 20. Loans having at least one payment.
SELECT *
FROM Loans l
WHERE EXISTS(
SELECT *
FROM Loan_Payments lp
WHERE lp.loan_id=l.loan_id
);

-- 21. Customers in Chennai branches using IN.
SELECT *
FROM Customers
WHERE customer_id IN(
SELECT customer_id
FROM Accounts
WHERE branch_id IN(
SELECT branch_id
FROM Branches
WHERE city='Chennai'
));

-- 22. Customers not having loans using NOT IN.
SELECT *
FROM Customers
WHERE customer_id NOT IN(
SELECT customer_id
FROM Loans
);

-- 23. Accounts with balances greater than ANY account in Mumbai.
SELECT *
FROM Accounts
WHERE balance>ANY(
SELECT balance
FROM Accounts
WHERE branch_id IN(
SELECT branch_id
FROM Branches
WHERE city='Mumbai'
));

-- 24. Accounts with balances greater than ALL savings accounts.
SELECT *
FROM Accounts
WHERE balance>ALL(
SELECT balance
FROM Accounts
WHERE account_type='Savings'
);

-- 25. Branches whose average balance exceeds all branch averages.
SELECT *
FROM Branches
WHERE branch_id IN(
SELECT branch_id
FROM Accounts
GROUP BY branch_id
HAVING AVG(balance)>=ALL(
SELECT AVG(balance)
FROM Accounts
GROUP BY branch_id
));

-- 26. Customer with highest total transaction amount.
SELECT *
FROM Customers
WHERE customer_id=(
SELECT customer_id
FROM Accounts
WHERE account_no=(
SELECT account_no
FROM Transactions
GROUP BY account_no
ORDER BY SUM(amount) DESC
LIMIT 1
));

-- 27. Customers who have both an account and a loan.
SELECT *
FROM Customers
WHERE customer_id IN(
SELECT customer_id FROM Accounts
)
AND customer_id IN(
SELECT customer_id FROM Loans
);

-- 28. Branch with highest total deposits.
SELECT *
FROM Branches
WHERE branch_id=(
SELECT branch_id
FROM Accounts
GROUP BY branch_id
ORDER BY SUM(balance) DESC
LIMIT 1
);

-- 29. Customers whose loan amount is above average loan amount.
SELECT *
FROM Customers
WHERE customer_id IN(
SELECT customer_id
FROM Loans
WHERE loan_amount>(
SELECT AVG(loan_amount)
FROM Loans
));

-- 30. Generate customer banking report using subqueries.
SELECT
customer_name,
(SELECT SUM(balance)
 FROM Accounts
 WHERE customer_id=c.customer_id) AS Total_Balance,
(SELECT COUNT(*)
 FROM Loans
 WHERE customer_id=c.customer_id) AS Total_Loans
FROM Customers c;


